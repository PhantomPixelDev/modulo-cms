# Docker dev environment for Modulo CMS
APP_NAME="Modulo CMS"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8000
ASSET_URL=http://localhost:8000

# APP_KEY can be empty; entrypoint will generate
APP_KEY=base64:S9DEkwCecN0cODw/ik60fPRf92k+55Zopurilcj0Hr8=

# Database: PostgreSQL (docker-dev/db)
DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=modulo
DB_USERNAME=modulo
DB_PASSWORD=secret

# Cache & Session
CACHE_STORE=file
SESSION_DRIVER=file
QUEUE_CONNECTION=sync

# Mail (Mailpit for dev)
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
MAIL_ADMIN_ADDRESS=admin@example.com

# Optional: auto-run migrations at container start
# RUN_MIGRATIONS=true

# Vite Configuration for Docker Development
VITE_HOST=localhost
VITE_PORT=5173
VITE_DEV_SERVER_URL=http://localhost:8000

# Vite Server Options
VITE_SERVER_HOST=0.0.0.0
VITE_SERVER_PORT=5173
VITE_SERVER_STRICT_PORT=true
VITE_SERVER_CORS=true

# Vite HMR Configuration
VITE_HMR_HOST=localhost
VITE_HMR_PORT=5173
VITE_HMR_PROTOCOL=ws
VITE_HMR_CLIENT_PORT=8000
VITE_HMR_ENABLED=true

# Vite Build Options
VITE_BUILD_OUTDIR=public/build
VITE_BUILD_TARGET=es2020
VITE_BUILD_MINIFY=false
VITE_BUILD_SOURCEMAP=true

# Vite Development Options
VITE_WATCH_USE_POLLING=true
VITE_WATCH_INTERVAL=1000
VITE_RELOAD_ON_SAVE=true

# Vite Plugin Options
VITE_LARAVEL_REFRESH=true
VITE_LARAVEL_SSR=true
VITE_REACT_FAST_REFRESH=false
