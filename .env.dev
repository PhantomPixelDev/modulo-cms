# Docker dev environment for Modulo CMS
APP_NAME="Modulo CMS"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8080
ASSET_URL=http://localhost:8080

# APP_KEY can be empty; entrypoint will generate
APP_KEY=base64:fr/QzmznhjB4nDdvtpQYxBYPeG9Qdv/O/hMj+4ewLbo=

# Database: PostgreSQL (docker-dev/db)
DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=modulo
DB_USERNAME=modulo
DB_PASSWORD=secret

# Cache & Session
CACHE_STORE=file
SESSION_DRIVER=file
QUEUE_CONNECTION=sync

# Mail (Mailpit for dev)
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
MAIL_ADMIN_ADDRESS=admin@example.com

# Optional: auto-run migrations at container start
# RUN_MIGRATIONS=true

# Vite configuration for Docker
VITE_HOST=localhost
VITE_PORT=5173
VITE_DEV_SERVER_URL=http://localhost:5173
