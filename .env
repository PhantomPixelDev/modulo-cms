# Docker Environment Configuration
# Copy this file to .env.docker and customize as needed

# Application Settings
APP_NAME="Modulo CMS"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=UTC

# Vite Configuration (handled by laravel-vite-plugin)
# No explicit VITE_* variables required for local development

# Database Configuration
DB_CONNECTION=sqlite
DB_DATABASE=database/database.sqlite
# For MySQL/PostgreSQL, uncomment and configure:
# DB_CONNECTION=pgsql
# DB_HOST=db
# DB_PORT=5432
# DB_DATABASE=modulo
# DB_USERNAME=modulo
# DB_PASSWORD=secret

# Cache & Session
# For production, consider using 'redis' for better performance.
CACHE_STORE=file
SESSION_DRIVER=file
QUEUE_CONNECTION=sync
# QUEUE_CONNECTION=redis
# REDIS_HOST=redis
# REDIS_PORT=6379

# Mail Configuration (Mailpit for local docker-dev)
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
# Optional admin recipient for notifications
MAIL_ADMIN_ADDRESS=
# For production SMTP:
# MAIL_MAILER=smtp
# MAIL_HOST=smtp.mailgun.org
# MAIL_PORT=587
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_ENCRYPTION=tls

# Theme Configuration
DEFAULT_THEME=modern-react

# Seeding Options
SEED_EXAMPLE_CONTENT=true

# SEO & Analytics (optional - can also be configured in admin)
# INDEXNOW_KEY=your-indexnow-key
# GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX
# GTM_CONTAINER_ID=GTM-XXXXXXX

# Docker Options
# RUN_MIGRATIONS=true
