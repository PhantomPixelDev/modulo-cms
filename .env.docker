# Docker runtime environment for Modulo CMS (production-like)
APP_NAME="Modulo CMS"
APP_ENV=production
APP_DEBUG=false
APP_URL=http://localhost:8080

# APP_KEY is generated in-container on first start; do not set here to avoid override

# Database: PostgreSQL (docker-compose 'db' service)
DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=modulo
DB_USERNAME=modulo
DB_PASSWORD=secret

# Cache & Session
CACHE_STORE=file
SESSION_DRIVER=file
QUEUE_CONNECTION=sync

# Mail (optional)
MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Optional: auto-run migrations at container start
# RUN_MIGRATIONS=true
