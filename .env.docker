# Production Docker Environment Configuration
# Copy this file to .env.docker and customize for production deployment

# Application Settings
APP_NAME="Modulo CMS"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://yourdomain.com
APP_TIMEZONE=UTC

# Database Configuration (PostgreSQL recommended for production)
DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=modulo_prod
DB_USERNAME=modulo
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# Cache & Session (Redis recommended for production)
CACHE_STORE=redis
SESSION_DRIVER=redis
QUEUE_CONNECTION=redis
REDIS_HOST=redis
REDIS_PORT=6379

# Mail Configuration (SMTP for production)
MAIL_MAILER=smtp
MAIL_HOST=smtp.mailgun.org
MAIL_PORT=587
MAIL_USERNAME=your-smtp-username
MAIL_PASSWORD=your-smtp-password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply@yourdomain.com"
MAIL_FROM_NAME="${APP_NAME}"
# Admin recipient for notifications
MAIL_ADMIN_ADDRESS=admin@yourdomain.com

# Theme Configuration
DEFAULT_THEME=modern-react

# SEO & Analytics (optional)
# INDEXNOW_KEY=your-indexnow-key
# GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX
# GTM_CONTAINER_ID=GTM-XXXXXXX

# Docker Options
RUN_MIGRATIONS=true

# Vite Configuration for Production Docker
VITE_HOST=yourdomain.com
VITE_PORT=5173
VITE_DEV_SERVER_URL=https://yourdomain.com

# Vite Server Options
VITE_SERVER_HOST=0.0.0.0
VITE_SERVER_PORT=5173
VITE_SERVER_STRICT_PORT=false
VITE_SERVER_CORS=false

# Vite Build Options
VITE_BUILD_OUTDIR=build
VITE_BUILD_TARGET=es2020
VITE_BUILD_MINIFY=true
VITE_BUILD_SOURCEMAP=false

# Vite Plugin Options
VITE_LARAVEL_REFRESH=false
VITE_LARAVEL_SSR=true
VITE_REACT_FAST_REFRESH=false
