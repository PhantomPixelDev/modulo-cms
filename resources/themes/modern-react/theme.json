{
    "name": "Modern React",
    "slug": "modern-react",
    "version": "1.0.0",
    "description": "Modern React-based theme using Inertia.js with TypeScript components and Tailwind CSS.",
    "author": "Modulo CMS",
    "author_url": "https://github.com/PhantomPixelDev/modulo-cms",
    "tags": ["react", "modern", "typescript", "inertia"],
    "supports": {
        "post_thumbnails": true,
        "menus": true,
        "widgets": true,
        "custom_logo": true,
        "responsive": true
    },
    "templates": {
        "layout": {
            "component": "components/Layout.tsx"
        },
        "header": {
            "component": "components/Header.tsx"
        },
        "footer": {
            "component": "components/Footer.tsx"
        },
        "post": {
            "component": "components/Post.tsx"
        },
        "products-single": {
            "component": "components/ProductsSingle.tsx"
        },
        "products": {
            "component": "components/Products.tsx"
        },
        "posts": {
            "component": "components/Posts.tsx"
        },
        "page": {
            "component": "components/Page.tsx"
        },
        "index": {
            "component": "components/Index.tsx"
        },
        "archive": {
            "component": "components/Archive.tsx"
        },
        "search": {
            "component": "components/Search.tsx"
        },
        "login": {
            "component": "components/Login.tsx"
        },
        "register": {
            "component": "components/Register.tsx"
        },
        "forgot-password": {
            "component": "components/ForgotPassword.tsx"
        },
        "reset-password": {
            "component": "components/ResetPassword.tsx"
        },
        "verify-email": {
            "component": "components/VerifyEmail.tsx"
        },
        "confirm-password": {
            "component": "components/ConfirmPassword.tsx"
        },
        "404": {
            "component": "components/NotFound.tsx"
        },
        "taxonomy": {
            "component": "components/TaxonomyTerm.tsx"
        },
        "Shop/Archive": {
            "component": "components/Shop/Archive.tsx"
        },
        "Shop/Single": {
            "component": "components/Shop/Single.tsx"
        },
        "Shop/Category": {
            "component": "components/Shop/Category.tsx"
        },
        "Shop/Cart": {
            "component": "components/Shop/Cart.tsx"
        },
        "Shop/Checkout": {
            "component": "components/Shop/Checkout.tsx"
        },
        "Shop/Account": {
            "component": "components/Shop/Account.tsx"
        },
        "Shop/OrderConfirmation": {
            "component": "components/Shop/OrderConfirmation.tsx"
        }
    },
    "partials": {
        "callout": {
            "component": "components/partials/Callout.tsx",
            "shortcode": true,
            "label": "Callout",
            "description": "Highlight useful information. Tone can be info, success or warning.",
            "fields": {
                "title": { "type": "text", "label": "Title" },
                "tone": {
                    "type": "select",
                    "label": "Tone",
                    "required": true,
                    "options": [
                        { "value": "info", "label": "Information" },
                        { "value": "success", "label": "Success" },
                        { "value": "warning", "label": "Warning" }
                    ]
                }
            },
            "defaults": { "tone": "info", "title": "" }
        },
        "disclosure": {
            "component": "components/partials/Disclosure.tsx",
            "shortcode": true,
            "label": "Collapsible section",
            "description": "Content readers can expand. Set open to true to start expanded.",
            "fields": {
                "title": { "type": "text", "label": "Title", "required": true },
                "open": { "type": "boolean", "label": "Start expanded" }
            },
            "defaults": { "title": "Details", "open": "false" }
        },
        "navigation": {
            "component": "components/partials/Navigation.tsx"
        },
        "sidebar": {
            "component": "components/partials/Sidebar.tsx"
        },
        "post-meta": {
            "component": "components/partials/PostMeta.tsx"
        },
        "comments": {
            "component": "components/partials/Comments.tsx"
        }
    },
    "assets": {
        "css": ["assets/css/theme.css"],
        "js": ["assets/js/theme.js"]
    },
    "menus": {
        "header": "Header Navigation",
        "footer": "Footer Links"
    },
    "widget_areas": {
        "sidebar": "Main Sidebar",
        "footer-1": "Footer Column 1",
        "footer-2": "Footer Column 2",
        "footer-3": "Footer Column 3"
    }
}
