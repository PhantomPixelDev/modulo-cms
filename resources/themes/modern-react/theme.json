{
    "name": "Modern React",
    "slug": "modern-react",
    "version": "1.0.0",
    "description": "Modern React-based theme using Inertia.js with TypeScript components and Tailwind CSS.",
    "author": "Modulo CMS",
    "author_url": "https://github.com/PhantomPixelDev/modulo-cms",
    "tags": ["react", "modern", "typescript", "inertia"],
    "settings": {
        "logo_style": {
            "type": "select",
            "group": "branding",
            "label": "Logo style",
            "default": "auto",
            "options": {
                "auto": "Automatic (site logo or initial)",
                "text": "Text only",
                "icon": "Icon",
                "image": "Image"
            }
        },
        "logo_text": {
            "type": "text",
            "group": "branding",
            "label": "Logo text",
            "default": ""
        },
        "logo_icon": {
            "type": "select",
            "group": "branding",
            "label": "Logo icon",
            "default": "layers",
            "options": {
                "layers": "Layers",
                "code": "Code",
                "globe": "Globe",
                "leaf": "Leaf",
                "box": "Box",
                "sparkles": "Sparkles",
                "square": "Square"
            }
        },
        "logo_image": {
            "type": "image",
            "group": "branding",
            "label": "Logo image",
            "default": ""
        },
        "dark_logo_image": {
            "type": "image",
            "group": "branding",
            "label": "Dark mode logo image",
            "default": ""
        },
        "logo_height": {
            "type": "number",
            "group": "branding",
            "label": "Logo height (px)",
            "default": 32,
            "min": 16,
            "max": 80
        },
        "logo_text_size": {
            "type": "number",
            "group": "branding",
            "label": "Logo text size (px)",
            "default": 18,
            "min": 12,
            "max": 36
        },
        "logo_show_text": {
            "type": "boolean",
            "group": "branding",
            "label": "Show text beside the logo",
            "default": true
        },
        "header_sticky": {
            "type": "boolean",
            "group": "header",
            "label": "Keep header visible while scrolling",
            "default": true
        },
        "header_density": {
            "type": "select",
            "group": "header",
            "label": "Header spacing",
            "default": "standard",
            "options": {
                "compact": "Compact",
                "standard": "Standard",
                "roomy": "Roomy"
            }
        },
        "header_theme_toggle": {
            "type": "boolean",
            "group": "header",
            "label": "Show light / dark switch",
            "default": true
        },
        "footer_show_brand": {
            "type": "boolean",
            "group": "footer",
            "label": "Show footer logo",
            "default": true
        },
        "footer_show_tagline": {
            "type": "boolean",
            "group": "footer",
            "label": "Show site tagline",
            "default": true
        },
        "footer_text": {
            "type": "text",
            "group": "footer",
            "label": "Footer copyright text",
            "default": ""
        },
        "footer_powered_by": {
            "type": "boolean",
            "group": "footer",
            "label": "Show Modulo CMS credit",
            "default": true
        },
        "primary_color": {
            "type": "color",
            "group": "colors",
            "label": "Brand color",
            "default": "#2563eb"
        },
        "background_color": {
            "type": "color",
            "group": "colors",
            "label": "Background",
            "default": "#ffffff"
        },
        "text_color": {
            "type": "color",
            "group": "colors",
            "label": "Text",
            "default": "#1e293b"
        },
        "surface_color": {
            "type": "color",
            "group": "colors",
            "label": "Muted surfaces",
            "default": "#f5f5f5"
        },
        "border_color": {
            "type": "color",
            "group": "colors",
            "label": "Borders",
            "default": "#e5e7eb"
        },
        "dark_primary_color": {
            "type": "color",
            "group": "dark_colors",
            "label": "Brand color",
            "default": "#60a5fa"
        },
        "dark_background_color": {
            "type": "color",
            "group": "dark_colors",
            "label": "Background",
            "default": "#171923"
        },
        "dark_text_color": {
            "type": "color",
            "group": "dark_colors",
            "label": "Text",
            "default": "#f1f5f9"
        },
        "dark_surface_color": {
            "type": "color",
            "group": "dark_colors",
            "label": "Muted surfaces",
            "default": "#252735"
        },
        "dark_border_color": {
            "type": "color",
            "group": "dark_colors",
            "label": "Borders",
            "default": "#383b4a"
        },
        "font_family": {
            "type": "select",
            "group": "layout",
            "label": "Font",
            "default": "system",
            "options": {
                "system": "System sans serif",
                "helvetica": "Helvetica / Arial",
                "serif": "Georgia",
                "mono": "Monospace"
            }
        },
        "container_width": {
            "type": "select",
            "group": "layout",
            "label": "Content width",
            "default": "standard",
            "options": {
                "compact": "Compact",
                "standard": "Standard",
                "wide": "Wide"
            }
        },
        "corner_style": {
            "type": "select",
            "group": "layout",
            "label": "Corners",
            "default": "rounded",
            "options": {
                "square": "Square",
                "subtle": "Subtle",
                "rounded": "Rounded",
                "soft": "Soft"
            }
        },
        "show_sidebar": {
            "type": "boolean",
            "group": "layout",
            "label": "Show article sidebar",
            "default": true
        }
    },
    "supports": {
        "post_thumbnails": true,
        "menus": true,
        "widgets": true,
        "custom_logo": true,
        "responsive": true
    },
    "templates": {
        "404": {
            "component": "components/NotFound.tsx"
        },
        "layout": {
            "component": "components/Layout.tsx"
        },
        "header": {
            "component": "components/Header.tsx"
        },
        "footer": {
            "component": "components/Footer.tsx"
        },
        "post": {
            "component": "components/Post.tsx"
        },
        "products-single": {
            "component": "components/ProductsSingle.tsx"
        },
        "products": {
            "component": "components/Products.tsx"
        },
        "posts": {
            "component": "components/Posts.tsx"
        },
        "page": {
            "component": "components/Page.tsx"
        },
        "index": {
            "component": "components/Index.tsx"
        },
        "archive": {
            "component": "components/Archive.tsx"
        },
        "search": {
            "component": "components/Search.tsx"
        },
        "login": {
            "component": "components/Login.tsx"
        },
        "register": {
            "component": "components/Register.tsx"
        },
        "forgot-password": {
            "component": "components/ForgotPassword.tsx"
        },
        "reset-password": {
            "component": "components/ResetPassword.tsx"
        },
        "verify-email": {
            "component": "components/VerifyEmail.tsx"
        },
        "confirm-password": {
            "component": "components/ConfirmPassword.tsx"
        },
        "taxonomy": {
            "component": "components/TaxonomyTerm.tsx"
        },
        "Shop/Archive": {
            "component": "components/Shop/Archive.tsx"
        },
        "Shop/Single": {
            "component": "components/Shop/Single.tsx"
        },
        "Shop/Category": {
            "component": "components/Shop/Category.tsx"
        },
        "Shop/Cart": {
            "component": "components/Shop/Cart.tsx"
        },
        "Shop/Checkout": {
            "component": "components/Shop/Checkout.tsx"
        },
        "Shop/Account": {
            "component": "components/Shop/Account.tsx"
        },
        "Shop/OrderConfirmation": {
            "component": "components/Shop/OrderConfirmation.tsx"
        }
    },
    "partials": {
        "callout": {
            "component": "components/partials/Callout.tsx",
            "shortcode": true,
            "label": "Callout",
            "description": "Highlight useful information. Tone can be info, success or warning.",
            "fields": {
                "title": {
                    "type": "text",
                    "label": "Title"
                },
                "tone": {
                    "type": "select",
                    "label": "Tone",
                    "required": true,
                    "options": [
                        {
                            "value": "info",
                            "label": "Information"
                        },
                        {
                            "value": "success",
                            "label": "Success"
                        },
                        {
                            "value": "warning",
                            "label": "Warning"
                        }
                    ]
                }
            },
            "defaults": {
                "tone": "info",
                "title": ""
            }
        },
        "disclosure": {
            "component": "components/partials/Disclosure.tsx",
            "shortcode": true,
            "label": "Collapsible section",
            "description": "Content readers can expand. Set open to true to start expanded.",
            "fields": {
                "title": {
                    "type": "text",
                    "label": "Title",
                    "required": true
                },
                "open": {
                    "type": "boolean",
                    "label": "Start expanded"
                }
            },
            "defaults": {
                "title": "Details",
                "open": "false"
            }
        },
        "navigation": {
            "component": "components/partials/Navigation.tsx"
        },
        "sidebar": {
            "component": "components/partials/Sidebar.tsx"
        },
        "post-meta": {
            "component": "components/partials/PostMeta.tsx"
        },
        "comments": {
            "component": "components/partials/Comments.tsx"
        }
    },
    "assets": {
        "css": ["assets/css/theme.css"],
        "js": ["assets/js/theme.js"]
    },
    "menus": {
        "header": "Header Navigation",
        "footer": "Footer Links"
    },
    "widget_areas": {
        "sidebar": "Main Sidebar",
        "footer-1": "Footer Column 1",
        "footer-2": "Footer Column 2",
        "footer-3": "Footer Column 3"
    }
}
