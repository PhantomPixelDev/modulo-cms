# Testing Environment Configuration
# Copy this file to .env.testing and customize for testing

# Application Settings
APP_NAME="Modulo CMS"
APP_ENV=testing
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=UTC

# Database Configuration (SQLite for testing)
DB_CONNECTION=sqlite
DB_DATABASE=database/database.sqlite

# Cache & Session (Array for testing)
CACHE_STORE=array
SESSION_DRIVER=array
QUEUE_CONNECTION=sync

# Mail Configuration (Log for testing)
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="test@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Theme Configuration
DEFAULT_THEME=modern-react

# Testing Options
SEED_EXAMPLE_CONTENT=false

# Vite Configuration for Testing
VITE_HOST=localhost
VITE_PORT=5173
VITE_DEV_SERVER_URL=http://localhost:5173

# Vite Server Options
VITE_SERVER_HOST=localhost
VITE_SERVER_PORT=5173
VITE_SERVER_STRICT_PORT=false
VITE_SERVER_CORS=true

# Vite Build Options
VITE_BUILD_OUTDIR=build
VITE_BUILD_TARGET=es2020
VITE_BUILD_MINIFY=false
VITE_BUILD_SOURCEMAP=true

# Vite Plugin Options
VITE_LARAVEL_REFRESH=false
VITE_LARAVEL_SSR=false
VITE_REACT_FAST_REFRESH=false