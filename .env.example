# Local (non-Docker) environment template
# Copy to .env and run: php artisan key:generate

# Application Settings
APP_NAME="Modulo CMS"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8000
APP_TIMEZONE=UTC

# Vite Configuration (handled by laravel-vite-plugin)
# No explicit VITE_* variables required for local development

# Database Configuration
DB_CONNECTION=sqlite
DB_DATABASE=database/database.sqlite
# For MySQL/PostgreSQL, uncomment and configure:
# DB_CONNECTION=pgsql
# DB_HOST=db
# DB_PORT=5432
# DB_DATABASE=modulo
# DB_USERNAME=modulo
# DB_PASSWORD=secret

# Cache & Session
# For production, consider using 'redis' for better performance.
CACHE_STORE=file
SESSION_DRIVER=file
QUEUE_CONNECTION=sync
# Encrypt session data at rest (recommended, required in production).
# SESSION_ENCRYPT=true
# Send session cookies over HTTPS only (required in production).
# SESSION_SECURE_COOKIE=true
# QUEUE_CONNECTION=redis
# REDIS_HOST=redis
# REDIS_PORT=6379

# Mail Configuration (Mailpit for local docker-dev)
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
# Optional admin recipient for notifications
MAIL_ADMIN_ADDRESS=
# For production SMTP:
# MAIL_MAILER=smtp
# MAIL_HOST=smtp.mailgun.org
# MAIL_PORT=587
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_ENCRYPTION=tls

# Theme Configuration
DEFAULT_THEME=modern-react

# Seeding Options
SEED_EXAMPLE_CONTENT=true

# SEO & Analytics (optional - can also be configured in admin)
# INDEXNOW_KEY=your-indexnow-key
# GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX
# GTM_CONTAINER_ID=GTM-XXXXXXX

# Docker Options
# RUN_MIGRATIONS=true

# Modulo CMS options (all optional; shown with defaults)
# Content: trash retention, revision history, public page cache.
# MODULO_TRASH_DAYS=30
# MODULO_REVISIONS_KEEP=25
# MODULO_PAGE_CACHE=true
# MODULO_PAGE_CACHE_TTL=3600
# Security headers, HSTS and Content-Security-Policy mode
# (off, report or enforce). Start with report, then enforce.
# MODULO_SECURITY_HEADERS=true
# MODULO_HSTS_MAX_AGE=15552000
# MODULO_CSP=report
# Extra CSP sources, space separated (e.g. https://cdn.example.com).
# MODULO_CSP_SCRIPT_SRC=
# MODULO_CSP_STYLE_SRC=
# MODULO_CSP_IMG_SRC=
# MODULO_CSP_CONNECT_SRC=
# MODULO_CSP_FRAME_SRC=
# MODULO_CSP_FONT_SRC=
# Password rules and 2FA/activity-log retention.
# MODULO_PASSWORD_MIN_LENGTH=12
# MODULO_PASSWORD_UNCOMPROMISED=true
# MODULO_REQUIRE_2FA_FOR_ADMINS=false
# MODULO_ACTIVITY_RETENTION_DAYS=180
# Headless API: requests per minute and largest page size.
# MODULO_API_RATE_LIMIT=120
# MODULO_API_MAX_PER_PAGE=100
# Backups: local path, how many to keep, and optional off-site disk.
# MODULO_BACKUP_PATH=
# MODULO_BACKUP_KEEP=5
# MODULO_BACKUP_SCHEDULE=
# MODULO_BACKUP_DISK=
# MODULO_BACKUP_DISK_PATH=
# MODULO_BACKUP_DISK_KEEP=
# Plugins and themes.
# MODULO_PLUGIN_PATH=
# MODULO_PLUGIN_REGISTRY=
# MODULO_PLUGIN_REGISTRY_TTL=3600
# MODULO_PLUGIN_TIMEOUT=30
# MODULO_PLUGIN_ALLOW_URL_INSTALL=false
# MODULO_THEME_INSTALL_PATH=
# Updates: repository, endpoints, cache and notification settings.
# MODULO_UPDATE_CHECK=true
# MODULO_UPDATE_REPOSITORY=
# MODULO_UPDATE_ENDPOINT=
# MODULO_UPDATE_LIST_ENDPOINT=
# MODULO_UPDATE_CACHE_TTL=3600
# MODULO_UPDATE_ERROR_CACHE_TTL=600
# MODULO_UPDATE_TIMEOUT=30
# MODULO_UPDATE_PRERELEASES=false
# MODULO_UPDATE_NOTIFY=true
