# Docker Environment Configuration
# Copy this file to .env.docker and customize as needed

# Application Settings
APP_NAME="Modulo CMS"
APP_ENV=local
APP_KEY=base64:NzVGDbuN8BqSKisNuGc1y6SodEqzgQn/8e4SqfjV8iU=
APP_DEBUG=true

# Vite Configuration (handled by laravel-vite-plugin)
# No explicit VITE_* variables required for local development


# Database Configuration
DB_CONNECTION=sqlite
DB_DATABASE=/home/pc/Documents/Github/modulo-cms/database/database.sqlite
# For MySQL/PostgreSQL, uncomment and configure:
# DB_CONNECTION=mysql
# DB_HOST=db
# DB_PORT=3306
# DB_DATABASE=modulo
# DB_USERNAME=root
# DB_PASSWORD=secret

# Cache & Session
# For production, consider using 'redis' for better performance.
CACHE_STORE=file
SESSION_DRIVER=file
# QUEUE_CONNECTION=redis
QUEUE_CONNECTION=sync

# Mail Configuration (optional)
MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"



# Theme Configuration
# Available themes: modern-react, flexia (or any custom theme)
DEFAULT_THEME=modern-react

# Seeding Options
SEED_EXAMPLE_CONTENT=true
