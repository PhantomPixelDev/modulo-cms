# Production environment template
# Copy to .env.prod and fill in real values. Never commit the filled-in file.

# Application Settings
APP_NAME="Modulo CMS"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://yourdomain.com
APP_TIMEZONE=UTC

# Host port nginx publishes the site on (compose reads this)
WEB_PORT=8080

# Release to run. `latest` follows the newest non-prerelease; pin an exact
# version (e.g. v1.2.3) for a predictable deploy.
MODULO_TAG=latest

# Database Configuration (PostgreSQL recommended for production)
DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=modulo_prod
DB_USERNAME=modulo
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# Cache & Session (Redis recommended for production)
CACHE_STORE=redis
SESSION_DRIVER=redis
QUEUE_CONNECTION=redis
REDIS_HOST=redis
REDIS_PORT=6379

# Session & security (production)
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
# Start with "report", check the browser console with your plugins and
# analytics, then switch to "enforce".
MODULO_CSP=enforce
# Require two-factor authentication for admin and super-admin roles.
MODULO_REQUIRE_2FA_FOR_ADMINS=true

# Mail Configuration (SMTP for production)
MAIL_MAILER=smtp
MAIL_HOST=smtp.mailgun.org
MAIL_PORT=587
MAIL_USERNAME=your-smtp-username
MAIL_PASSWORD=your-smtp-password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply@yourdomain.com"
MAIL_FROM_NAME="${APP_NAME}"
# Admin recipient for notifications
MAIL_ADMIN_ADDRESS=admin@yourdomain.com

# Theme Configuration
DEFAULT_THEME=modern-react

# SEO & Analytics (optional)
# INDEXNOW_KEY=your-indexnow-key
# GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX
# GTM_CONTAINER_ID=GTM-XXXXXXX

# Docker Options
RUN_MIGRATIONS=true


# Public disposable demo only; normal sites keep this disabled.
MODULO_DEMO=false
