{
    "name": "modulo-cms",
    "version": "0.0.0-dev",
    "description": "A modern, modular content management system built on Laravel 12 with a React 19 frontend.",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/PhantomPixelDev/modulo-cms.git"
    },
    "homepage": "https://github.com/PhantomPixelDev/modulo-cms",
    "bugs": {
        "url": "https://github.com/PhantomPixelDev/modulo-cms/issues"
    },
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vite build",
        "build:ssr": "vite build && vite build --ssr",
        "build:shims": "node scripts/build-plugin-shims.mjs",
        "dev": "vite",
        "format": "prettier --write resources/",
        "format:check": "prettier --check resources/",
        "lint": "eslint . --fix",
        "types": "tsc --noEmit",
        "clean": "npm run clean:php && npm run clean:frontend",
        "clean:php": "bash -lc 'php artisan optimize:clear && php artisan cache:clear && php artisan view:clear || true'",
        "clean:frontend": "bash -lc 'rm -rf .vite public/build tsconfig.tsbuildinfo resources/js/*.tsbuildinfo .eslintcache'",
        "test:js": "vitest run",
        "test:js:coverage": "vitest run --coverage",
        "test:js:watch": "vitest",
        "test:e2e": "playwright test",
        "docs:dev": "vitepress dev docs",
        "docs:build": "vitepress build docs"
    },
    "devDependencies": {
        "@eslint/js": "^9.19.0",
        "@playwright/test": "^1.63.0",
        "@testing-library/jest-dom": "^7.0.1",
        "@testing-library/react": "^16.3.3",
        "@testing-library/user-event": "^14.6.7",
        "@types/node": "^24.3.1",
        "@vitest/coverage-v8": "^5.0.1",
        "eslint": "^9.17.0",
        "eslint-config-prettier": "^10.0.1",
        "eslint-plugin-react": "^7.37.3",
        "eslint-plugin-react-hooks": "^5.1.0",
        "jsdom": "^30.1.0",
        "prettier": "^3.9.8",
        "prettier-plugin-organize-imports": "^4.3.0",
        "prettier-plugin-tailwindcss": "^0.8.1",
        "sass": "^1.104.1",
        "typescript-eslint": "^8.70.0",
        "vitepress": "^2.0.0-alpha.20",
        "vitest": "^5.0.1"
    },
    "dependencies": {
        "@headlessui/react": "^2.2.10",
        "@inertiajs/react": "^2.1.4",
        "@radix-ui/react-avatar": "^1.2.6",
        "@radix-ui/react-checkbox": "^1.3.11",
        "@radix-ui/react-collapsible": "^1.1.20",
        "@radix-ui/react-dialog": "^1.1.23",
        "@radix-ui/react-dropdown-menu": "^2.1.24",
        "@radix-ui/react-label": "^2.1.15",
        "@radix-ui/react-navigation-menu": "^1.2.22",
        "@radix-ui/react-scroll-area": "^1.2.18",
        "@radix-ui/react-select": "^2.3.7",
        "@radix-ui/react-separator": "^1.1.15",
        "@radix-ui/react-slot": "^1.1.2",
        "@radix-ui/react-switch": "^1.3.7",
        "@radix-ui/react-tabs": "^1.1.21",
        "@radix-ui/react-toggle": "^1.1.18",
        "@radix-ui/react-toggle-group": "^1.1.19",
        "@radix-ui/react-tooltip": "^1.2.16",
        "@tailwindcss/vite": "^4.3.3",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@vitejs/plugin-react": "^5.0.2",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "date-fns": "^4.4.0",
        "globals": "^15.14.0",
        "laravel-vite-plugin": "^2.0.1",
        "lucide-react": "^0.543.0",
        "qrcode.react": "^4.2.0",
        "react": "^19.3.0",
        "react-dom": "^19.3.0",
        "slate": "^0.126.2",
        "slate-dom": "^0.126.0",
        "slate-history": "^0.113.1",
        "slate-react": "^0.126.4",
        "sonner": "^2.0.8",
        "tailwind-merge": "^3.7.0",
        "tailwindcss-animate": "^1.0.7",
        "typescript": "^5.9.2",
        "vite": "^7.3.6",
        "ziggy-js": "^2.6.4"
    },
    "optionalDependencies": {
        "@rollup/rollup-linux-x64-gnu": "4.63.3",
        "@tailwindcss/oxide-linux-x64-gnu": "^4.0.1",
        "lightningcss-linux-x64-gnu": "^1.29.1"
    }
}
